{
  "name": "splitease",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "playwright test",
    "dev:backend": "npm run dev --workspace backend",
    "build:backend": "npm run build --workspace backend",
    "check": "npm run build && npm run build:backend && npm test --workspace backend && npm run test:privacy && npm test",
    "test:privacy": "node tests/privacy.sql.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
