PORT=3001
CORS_ORIGIN=http://127.0.0.1:5173

# Supabase verifies the signed-in payer for Stripe checkout. Required when enabling checkout.
# Stripe owns test session status; this app does not yet keep a financial ledger.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe sandbox only. Never put these secrets in frontend environment variables.
STRIPE_SANDBOX_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://127.0.0.1:5173
